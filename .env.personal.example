# =====================================================================
# Lyrithm Personal Edition — .env template
# =====================================================================
# 1. Copy: cp .env.personal.example .env
# 2. Set every CHANGE_ME / GENERATE_ME below.
# 3. chmod 600 .env  (Linux/macOS) — keeps secrets off other accounts.
# 4. NEVER commit this file once it has real secrets.
# =====================================================================

# ---------- Database ----------
# Internal-only postgres (not exposed to host). Pick any password you like
# — only docker-compose services on the same network ever see it.
DB_NAME=lyrithm
DB_USER=lyrithm
DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# ---------- Master encryption key ----------
# Required. Encrypts your exchange API keys at rest in the local DB.
# Generate ONCE and keep this value forever — losing it means every
# stored exchange credential becomes unreadable.
#
# Generate with:   openssl rand -base64 32
LYRITHM_MASTER_KEY=GENERATE_ME_WITH_openssl_rand_base64_32

# ---------- Image version pin ----------
# Stay on a single major version (v1.x.x) for the lifetime of your
# purchased update window. Bump only patch/minor within v1.
# Verified Personal 1.3.7 image set: engine, dashboard and Python worker.
# Legacy LYRITHM_VERSION remains the fallback for all three services.
LYRITHM_VERSION=1.3.7
# Set these independently ONLY to the exact tags in the release notes:
# LYRITHM_ENGINE_VERSION=1.3.7
# LYRITHM_DASHBOARD_VERSION=1.3.7
# LYRITHM_WORKER_VERSION=1.3.7
GHCR_OWNER=lyrithm-io

# ---------- Cloud endpoints ----------
# Override only for staging / self-hosted Cloud mirror. Default points
# at the public Lyrithm Cloud activation + Observatory endpoints.
LYRITHM_ACTIVATION_API_URL=https://api.lyrithm.io
LYRITHM_OBSERVATORY_API_URL=https://api.lyrithm.io

# ---------- Risk defaults ----------
# RISK_PER_TRADE = USDT risk per signal (Lyrithm sizes positions for you)
# MAX_DAILY_LOSS = circuit-breaker — bot stops trading if hit
# Both are also adjustable at runtime from the dashboard Risk page.
RISK_PER_TRADE=100
MAX_DAILY_LOSS=300

# ---------- Telegram alerts via Lyrithm Pulse (recommended) ----------
# v1.0.4 default: alerts are delivered through the Cloud @lyrithm_pulse_bot.
# You do NOT need to create your own bot at @BotFather. Open the
# dashboard Settings page → Telegram Notifications → tap "Bind via
# Telegram" → tap Start on @lyrithm_pulse_bot in Telegram. Done.
#
# The values below are already correct for the default flow — leave
# them as-is unless you have a reason to override.
LYRITHM_PULSE_ENABLED=true
LYRITHM_PULSE_BOT_USERNAME=lyrithm_pulse_bot
LYRITHM_PULSE_RELAY_ENABLED=true
LYRITHM_PULSE_RELAY_ENDPOINT=https://api.lyrithm.io

# ---------- Optional: legacy direct Telegram bot (advanced) ----------
# Only set these if you want to run your OWN bot (via @BotFather) instead
# of @lyrithm_pulse_bot — e.g. for self-hosted privacy or to use a custom
# bot name. When set, alerts are sent directly from your box to Telegram
# and the relay path becomes a fallback. Leave blank to use Pulse only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# ---------- Backup encryption (SEC-012, recommended) ----------
# The dashboard "Download backup" button streams a full pg_dump — which
# INCLUDES your encrypted exchange credentials and all trade data. Left
# unencrypted, that .sql.gz sitting in Downloads / on a USB stick is a
# credential-exfil risk. Set a key and the download becomes an AES-256-GCM
# container (file: lyrithm-personal-backup-YYYY-MM-DD.sql.gz.enc).
#
# Generate once:   openssl rand -base64 32
# Store it OUTSIDE the backup — losing the key means the backup is
# unrecoverable. Unset = unencrypted backups + a boot warning.
LYRITHM_BACKUP_ENCRYPTION_KEY=
#
# Keep the backup encryption key outside the backup archive.
# See SETUP.personal.md for the complete backup/restore checklist.
#
# Offsite copy (the other half of SEC-012) is NOT automated here — it needs
# infrastructure (an object-store bucket + credentials, or a mounted volume
# + a cron job). Recommended: a host cron that curls this endpoint and pushes
# the .enc file to your offsite target. Tracked as an ops follow-up.
