# =====================================================================
# Lyrithm Personal Edition - .env template
# =====================================================================
# 1. Copy: cp .env.personal.example .env
# 2. Set every CHANGE_ME / GENERATE_ME below.
# 3. chmod 600 .env  (Linux/macOS) to keep secrets off other accounts.
# 4. NEVER commit .env once it has real secrets.
# =====================================================================

# ---------- Database ----------
# Internal-only postgres. Not exposed to the host.
DB_NAME=lyrithm
DB_USER=lyrithm
DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# ---------- Master encryption key ----------
# Required. Encrypts exchange API keys at rest in the local DB.
# Generate ONCE and keep this value forever. Losing it means stored
# exchange credentials become unreadable.
#
# Generate with: openssl rand -base64 32
LYRITHM_MASTER_KEY=GENERATE_ME_WITH_openssl_rand_base64_32

# ---------- Image version pin ----------
# Stay on v1.x.x for your purchased update window.
LYRITHM_VERSION=1.0.4
GHCR_OWNER=lyrithm-io

# ---------- Cloud endpoints ----------
# Override only for staging / self-hosted Cloud mirror.
LYRITHM_ACTIVATION_API_URL=https://api.lyrithm.io
LYRITHM_OBSERVATORY_API_URL=https://api.lyrithm.io

# ---------- Risk defaults ----------
# RISK_PER_TRADE = USDT risk per signal.
# MAX_DAILY_LOSS = circuit breaker; bot stops trading if hit.
RISK_PER_TRADE=100
MAX_DAILY_LOSS=300

# ---------- Optional: Telegram alerts ----------
# Get a bot token from @BotFather. Leave unset to silence alerts.
# Settings -> Telegram Notifications needs BOT_TOKEN + BOT_USERNAME +
# LYRITHM_PULSE_ENABLED=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
LYRITHM_PULSE_ENABLED=false
LYRITHM_PULSE_BOT_USERNAME=
LYRITHM_PULSE_WIDGET_DOMAIN=
